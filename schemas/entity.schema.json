{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/echorym/schemas/entity.schema.json",
  "title": "Echorym Entity",
  "type": "object",
  "required": [
    "schema_version",
    "entity_id",
    "name",
    "entity_type",
    "state"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "player-facing guide",
        "anchor",
        "conduit",
        "trust network",
        "memory-bearing location",
        "signal source",
        "unknown presence",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "state": {
      "type": "object",
      "properties": {
        "coherence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "trust_posture": {
          "type": "string"
        },
        "signal_integrity": {
          "type": "string",
          "enum": [
            "unknown",
            "low",
            "partial",
            "stable",
            "high",
            "corrupted"
          ],
          "description": "DEPRECATED (v0.2): combined axis. Prefer signal_provenance + signal_quality. Retained so 0.1.0 records validate."
        },
        "resilience": {
          "type": "string",
          "enum": [
            "unknown",
            "fragile",
            "strained",
            "adaptive",
            "resilient"
          ]
        },
        "active": {
          "type": "boolean"
        },
        "signal_provenance": {
          "type": "string",
          "enum": [
            "unknown",
            "inferred",
            "confirmed"
          ],
          "description": "Knowledge axis of the entity's governing signal."
        },
        "signal_quality": {
          "type": "string",
          "enum": [
            "intact",
            "degraded",
            "corrupted"
          ],
          "description": "Condition axis of the entity's governing signal."
        },
        "resilience_trend": {
          "type": "string",
          "description": "Optional trend qualifier on the resilience point value (e.g. 'stabilizing', 'deteriorating', 'oscillating'). Obs #2: enums cannot hold a trend; this carries it as state rather than prose."
        }
      },
      "additionalProperties": false
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_id",
          "relationship_type"
        ],
        "properties": {
          "target_id": {
            "type": "string"
          },
          "relationship_type": {
            "type": "string"
          },
          "trust": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "memory_trace_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "created_by": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "review_status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "v0.2 amendments (additive): state gains signal_provenance/signal_quality (obs #3) and resilience_trend (obs #2); legacy signal_integrity deprecated but valid. All 0.1.0 records remain valid."
}