{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/echorym/schemas/player_state.schema.json",
  "title": "Echorym Player State",
  "type": "object",
  "required": [
    "schema_version",
    "player_id",
    "declared_intent",
    "coherence",
    "known_signals",
    "memory_trace_ids"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "declared_intent": {
      "type": "string"
    },
    "inferred_intent": {
      "type": "string"
    },
    "coherence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "trust_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_id",
          "trust"
        ],
        "properties": {
          "target_id": {
            "type": "string"
          },
          "trust": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "basis": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "known_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "signal_id",
          "integrity"
        ],
        "properties": {
          "signal_id": {
            "type": "string"
          },
          "integrity": {
            "type": "string",
            "enum": [
              "unknown",
              "low",
              "partial",
              "stable",
              "high",
              "corrupted"
            ]
          },
          "interpretation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "memory_trace_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_history": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

