{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/echorym/schemas/player_state.schema.json",
  "title": "Echorym Player State",
  "type": "object",
  "required": [
    "schema_version",
    "player_id",
    "declared_intent",
    "coherence",
    "known_signals",
    "memory_trace_ids"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "declared_intent": {
      "type": "string"
    },
    "inferred_intent": {
      "type": "string"
    },
    "coherence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "trust_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_id",
          "trust"
        ],
        "properties": {
          "target_id": {
            "type": "string"
          },
          "trust": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "basis": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "known_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "signal_id"
        ],
        "properties": {
          "signal_id": {
            "type": "string"
          },
          "integrity": {
            "type": "string",
            "enum": [
              "unknown",
              "low",
              "partial",
              "stable",
              "high",
              "corrupted"
            ],
            "description": "DEPRECATED (v0.2): fuses a knowledge axis and a quality axis in one field. Prefer provenance + quality + interpretation_status. Retained so 0.1.0 records validate."
          },
          "interpretation": {
            "type": "string"
          },
          "provenance": {
            "type": "string",
            "enum": [
              "unknown",
              "inferred",
              "confirmed"
            ],
            "description": "Knowledge axis: how well the signal's origin is established. Can improve while quality does not."
          },
          "quality": {
            "type": "string",
            "enum": [
              "intact",
              "degraded",
              "corrupted"
            ],
            "description": "Physical/structural axis: the condition of the signal itself. Independent of provenance."
          },
          "interpretation_status": {
            "type": "string",
            "enum": [
              "partial",
              "contested",
              "clarified"
            ],
            "description": "Status of the reading. 'interpretation' (free text) remains the rationale for this status."
          }
        },
        "additionalProperties": false
      }
    },
    "memory_trace_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_history": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "description": "v0.2 amendments (additive): known_signals gains provenance/quality/interpretation_status axes per SCHEMA_OBSERVATIONS #3; legacy 'integrity' deprecated but valid. All 0.1.0 records remain valid."
}